<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PORTAL.Desktop</AssemblyName>
    <RootNamespace>Portal.Desktop</RootNamespace>
    <Version>5.10.0</Version>
    <FileVersion>5.10.0.60</FileVersion>
    <AssemblyVersion>5.10.0.0</AssemblyVersion>
    <InformationalVersion>5.10.0-network-cutover-hotfix</InformationalVersion>
    <PortalBuildNumber Condition="'$(PortalBuildNumber)' == ''">60</PortalBuildNumber>
    <PortalBuildDate Condition="'$(PortalBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</PortalBuildDate>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PortalBuildNumber" Value="$(PortalBuildNumber)" />
    <AssemblyMetadata Include="PortalBuildDate" Value="$(PortalBuildDate)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="desktop-update-signing-public.pem" LogicalName="Portal.Desktop.desktop-update-signing-public.pem" />
  </ItemGroup>
</Project>
