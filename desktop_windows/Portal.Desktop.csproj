<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PORTAL.Desktop</AssemblyName>
    <RootNamespace>Portal.Desktop</RootNamespace>
    <Version>5.4.0</Version>
    <FileVersion>5.4.0.54</FileVersion>
    <AssemblyVersion>5.4.0.0</AssemblyVersion>
    <InformationalVersion>5.4-modal-dismiss-lock</InformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PortalBuildDate>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</PortalBuildDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PortalBuildDate" Value="$(PortalBuildDate)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
