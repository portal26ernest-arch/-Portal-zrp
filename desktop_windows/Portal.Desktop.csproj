<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PORTAL.Desktop</AssemblyName>
    <RootNamespace>Portal.Desktop</RootNamespace>
    <Version>4.5.0</Version>
    <FileVersion>4.5.0.45</FileVersion>
    <AssemblyVersion>4.5.0.0</AssemblyVersion>
    <InformationalVersion>4.5-organizer-chat</InformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="desktop-update-signing-public.pem" LogicalName="Portal.Desktop.desktop-update-signing-public.pem" />
  </ItemGroup>
</Project>
