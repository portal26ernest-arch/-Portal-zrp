# Non-secret fail-closed example. Store real DSNs only in /etc/portal/portal.env.
PORTAL_ENV=production
PORTAL_DB_BACKEND=postgresql
PORTAL_APP_HOST=127.0.0.1
PORTAL_APP_PORT=8765
PORTAL_PUBLIC_API_URL=https://__PORTAL_HOST__
PORTAL_DOCUMENT_ROOT=/var/lib/portal/documents

# Populate these on the server using protected credentials; do not commit values.
PORTAL_DATABASE_URL=
PORTAL_CONTROL_DATABASE_URL=

# Deliberately false in the repository example.
# Change to true only during the explicitly authorized production cutover.
PORTAL_ENABLE_POSTGRES_PRODUCTION=false

# Optional Desktop update channel; publish only manifests with a valid signature.
PORTAL_DESKTOP_UPDATE_VERSION=
PORTAL_DESKTOP_UPDATE_BUILD=
PORTAL_DESKTOP_UPDATE_URL=
PORTAL_DESKTOP_UPDATE_SHA256=
PORTAL_DESKTOP_UPDATE_SIGNATURE=

# Optional OpenAI Code Interpreter. The real OPENAI_API_KEY belongs only in
# /etc/portal/portal.env (0600/root-owned) and must never be committed.
PORTAL_CODE_INTERPRETER_ENABLED=false
PORTAL_CODE_INTERPRETER_MODEL=gpt-5.4-mini
PORTAL_CODE_INTERPRETER_MEMORY=1g
PORTAL_CODE_INTERPRETER_TIMEOUT_SECONDS=180
OPENAI_API_KEY=

# Optional privacy-minimized PostHog server observability. Keep the real project
# key only in the protected server environment; no client/user identifiers are sent.
PORTAL_POSTHOG_PROJECT_KEY=
PORTAL_POSTHOG_HOST=https://eu.i.posthog.com
PORTAL_POSTHOG_SLOW_MS=2000
