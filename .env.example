# Template only. Copy outside Git and provide values through systemd EnvironmentFile.
PORTAL_ENV=development
PORTAL_DB_BACKEND=sqlite
PORTAL_DB=/absolute/path/to/portal.db
PORTAL_APP_HOST=127.0.0.1
PORTAL_APP_PORT=8765
PORTAL_PUBLIC_API_URL=http://127.0.0.1:8765

# Isolated PostgreSQL test only. Keep actual credentials in a protected
# EnvironmentFile outside Git; the API binds to loopback until HTTPS cutover.
# PORTAL_ENV=test
# PORTAL_DB_BACKEND=postgresql
# PORTAL_DATABASE_URL=postgresql://TENANT_ROLE:SECRET@127.0.0.1:5432/portal_test_example
# PORTAL_CONTROL_DATABASE_URL=postgresql://CONTROL_ROLE:SECRET@127.0.0.1:5432/portal_test_example
# PORTAL_APP_HOST=127.0.0.1

# Optional OpenAI Code Interpreter. Keep the API key only in a protected server
# EnvironmentFile; never embed it in Android/Desktop/iOS/Web assets.
PORTAL_CODE_INTERPRETER_ENABLED=false
PORTAL_CODE_INTERPRETER_MODEL=gpt-5.4-mini
PORTAL_CODE_INTERPRETER_MEMORY=1g
PORTAL_CODE_INTERPRETER_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
