# Non-secret example. Do not commit real credentials.
# Prefer PGSERVICE/PGPASSFILE or protected environment files mode 0600/0640.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=portal_backup
PGSERVICE=
PGPASSFILE=/etc/portal/.pgpass
# Optional: add --age-recipient-file /etc/portal/backup-age-recipients.txt to ExecStart.
