# PORTAL Messenger Relay — example only. Never commit production secrets.
# Optional direct HTTPS CONNECT transport for a future owned Western VPS.
PORTAL_MESSENGER_RELAY_URL=https://relay-eu.vart-portal.ru:9443
# Preferred Cloudflare-compatible transport on the current infrastructure.
PORTAL_MESSENGER_RELAY_WSS_URL=wss://relay.vart-portal.ru/connect
PORTAL_MESSENGER_RELAY_WS_BIND=127.0.0.1
PORTAL_MESSENGER_RELAY_WS_PORT=9444
PORTAL_MESSENGER_RELAY_WS_MAX_FRAME=131072
PORTAL_MESSENGER_RELAY_WS_IDLE_SECONDS=300
PORTAL_MESSENGER_RELAY_SECRET=replace-with-at-least-32-random-characters
PORTAL_MESSENGER_RELAY_TTL_SECONDS=43200
PORTAL_MESSENGER_RELAY_BIND=0.0.0.0
PORTAL_MESSENGER_RELAY_PORT=9443
PORTAL_MESSENGER_RELAY_CERT=/etc/portal-production/relay/fullchain.pem
PORTAL_MESSENGER_RELAY_KEY=/etc/portal-production/relay/privkey.pem
PORTAL_MESSENGER_RELAY_ALLOWED_SUFFIXES=telegram.org,t.me
PORTAL_MESSENGER_RELAY_MAX_CONNECTIONS=256
# Optional on an owned non-Western VPS: Telegram relay outbound only via local Tor.
# Must be socks5://127.0.0.1:19050 (or another loopback SOCKS5 endpoint).
# If configured, relay startup rejects non-loopback URLs and never falls back direct.
PORTAL_MESSENGER_RELAY_UPSTREAM_SOCKS5=socks5://127.0.0.1:19050
