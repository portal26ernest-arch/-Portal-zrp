# Copy to /etc/portal/offsite-backup.env; protect as root:portal-offsite 0640.
# Values below are intentionally empty: supply credentials out of band.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/portal/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Repository format: s3:https://s3.example.invalid/bucket/portal-central
# Never put credentials in the repository URL. Do not commit this file after filling it.
