[Unit]
Description=PORTAL Telegram Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal
Group=portal
EnvironmentFile=/etc/portal-production/messenger-relay.env
WorkingDirectory=/srv/portal-messenger-relay/current/server
ExecStart=/usr/bin/python3 /srv/portal-messenger-relay/current/server/messenger_relay.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/portal-production/relay
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
