[Unit]
Description=Dedicated PORTAL Messenger Tor client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal-tor
Group=portal-tor
ExecStart=/usr/bin/tor -f /etc/tor/portal-messenger-torrc
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portal-messenger-tor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
